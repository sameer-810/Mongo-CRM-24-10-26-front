# Server
BACKEND_API_URL=http://localhost:4000
# Optional: sent as X-API-Secret if the backend requires it
# BACKEND_API_SECRET=
# One URL only: the address this frontend is served from
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>

# Branding (public, baked in at build time; redeploy after changing)
NEXT_PUBLIC_SITE_NAME=FiveM Infotech CRM
NEXT_PUBLIC_COMPANY_NAME=FiveM Infotech
# Domain appended to usernames when creating users (no @)
NEXT_PUBLIC_EMAIL_DOMAIN=bakerandco.ae
# Optional, defaults to info@<NEXT_PUBLIC_EMAIL_DOMAIN>
NEXT_PUBLIC_CONTACT_EMAIL=info@bakerandco.ae
